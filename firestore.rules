rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /ramenLogs/{userId} {
      function isOwner() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid == userId;
      }

      function ownsExistingDocument() {
        return isOwner() && resource.data.ownerUid == request.auth.uid;
      }

      allow get: if isOwner()
        && (!exists(/databases/$(database)/documents/ramenLogs/$(userId))
          || get(/databases/$(database)/documents/ramenLogs/$(userId)).data.ownerUid == request.auth.uid);

      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.list is list
        && request.resource.data.keys().hasOnly(['ownerUid', 'username', 'list']);

      allow update: if ownsExistingDocument()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.list is list
        && request.resource.data.keys().hasOnly(['ownerUid', 'username', 'list']);

      allow delete: if ownsExistingDocument();
    }
  }
}
